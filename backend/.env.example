# Copy to .env and fill in values before running locally
# On Railway / Render, set these as environment variables in the dashboard.

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Optional: override default model paths
FATIGUE_MODEL_PATH=models/fatigue_model.h5
SMOKING_MODEL_PATH=models/smoking_model.h5
